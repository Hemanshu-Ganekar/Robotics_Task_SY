import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Vector3
import random
class sensorClass(Node):
    def __init__(self):
        super().__init__("sensor")
        self.sensor = self.create_publisher(Vector3,"IMU",10)
        self.timer = self.create_timer(2.0,self.timer_callback)

    def timer_callback(self):
        msg = Vector3()
        msg.x = float(random.randint(1,10))
        msg.y = float(random.randint(1,10))
        msg.z = float(random.randint(1,10))
        self.sensor.publish(msg)

def main(args=None):
    rclpy.init(args=args)
    sensorObj = sensorClass()
    rclpy.spin(sensorObj)
    rclpy.shutdown()

if __name__ == "__main__":
    main()
    

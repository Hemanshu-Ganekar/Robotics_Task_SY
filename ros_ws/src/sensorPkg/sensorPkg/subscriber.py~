import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Vector3

class subscriberClass(Node):
    def __init__(self):
        super().__init__("subscriberNode")
        self.subscriber = self.create_subscription(Vector3,"IMU",self.subscription_callback,10)

    def subscription_callback(self,msg:Vector3):
        self.get_logger().info(f"x : {msg.x}, y : {msg.y}, z : {msg.z}")

def main(args=None):
    rclpy.init(args=args)
    subs = subscriberClass()
    rclpy.spin(subs)
    rclpy.shutdown()

if __name__ == "__main__":
    main()
        
        

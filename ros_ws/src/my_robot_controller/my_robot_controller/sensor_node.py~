import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Vector3
import random

class sensor(Node):
    def __init__(self):
        super().__init__("sensor_node")
        self.sensor_node = self.create_publisher(Vector3,"IMU",10)
        self.timer = self.create_timer(2.0,self.timer_callback)

    def timer_callback(self):
        msg= Vector3()
        msg.x = float(random.randint(1,10))
        msg.y = float(random.randint(1,10))
        msg.z = float(random.randint(1,10))
        msg.freq = 2.0 
        self.sensor_node.publish(msg)

def main(args=None):
    rclpy.init(args=args)
    sensorNode= sensor()
    rclpy.spin(sensorNode)
    rclpy.shutdown()

if __name__ == '__main__':
    main()
